[gd_resource type="Resource" script_class="WaveDefinition" format=3]

[ext_resource type="Script" path="res://scripts/waves/WaveDefinition.gd" id="1_wave"]
[ext_resource type="Script" path="res://scripts/waves/WaveSpawn.gd" id="2_spawn"]
[ext_resource type="PackedScene" path="res://scenes/enemy/PatrolJet.tscn" id="3_patrol"]
[ext_resource type="Resource" path="res://resources/formations/Echelon.tres" id="4_echelon"]
[ext_resource type="Resource" path="res://levels/Retaliation.tres" id="5_engaged"]
[ext_resource type="Resource" path="res://levels/Probe.tres" id="6_ignored"]

[sub_resource type="Resource" id="S1"]
script = ExtResource("2_spawn")
time = 0.0
enemy_scene = ExtResource("3_patrol")
distance = Vector2(1600, 1600)
altitude = Vector2(300, 300)
formation = ExtResource("4_echelon")
